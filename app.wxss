page { background: #f7f8fc; color: #202536; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.container { padding: 28rpx; }
.panel { background: #fff; border-radius: 24rpx; padding: 28rpx; box-shadow: 0 8rpx 28rpx rgba(31,45,80,.05); }
.muted { color: #7b8498; }
.primary { background: #405cf5; color: #fff; border-radius: 16rpx; }
.secondary { background: #edf0ff; color: #405cf5; border-radius: 16rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.section-title { font-size: 30rpx; font-weight: 700; margin: 28rpx 0 18rpx; }
button { font-size: 28rpx; }
button::after { border: 0; }
