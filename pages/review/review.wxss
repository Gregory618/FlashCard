.progress-row { display:flex; justify-content:space-between; margin: 12rpx 4rpx 16rpx; }
.progress { height: 10rpx; background:#e5e9f5; border-radius:10rpx; overflow:hidden; }
.progress-inner { height:100%; background:#5369ec; border-radius:10rpx; }
.flashcard { min-height: 660rpx; margin-top: 28rpx; display:flex; flex-direction:column; justify-content:center; text-align:center; }
.side-label { color:#7180a0; font-size:22rpx; letter-spacing:4rpx; margin-bottom:48rpx; }
.word { font-size:54rpx; font-weight:800; color:#26345d; }
.example { font-size:32rpx; line-height:1.6; margin-top:38rpx; }
.tap-hint { margin-top:70rpx; font-size:22rpx; }
.answer { text-align:left; }
.meaning { font-size:36rpx; font-weight:700; line-height:1.5; }
.detail { font-size:28rpx; line-height:1.65; margin-top:34rpx; color:#46516a; }
.detail-title { display:block; color:#8790a5; font-size:22rpx; margin-bottom:8rpx; }
.reveal { margin-top:24rpx; }
.grading { margin-top:28rpx; }
.grade-hint { text-align:center; margin-bottom:18rpx; }
.grade-buttons { display:flex; gap:18rpx; }
.grade-buttons button { flex:1; }
.again { background:#fff0ed; color:#bd543f; }
.remembered { background:#e9f7ef; color:#218454; }
.done { text-align:center; margin-top:160rpx; }
.done-title { font-size:44rpx; font-weight:800; margin-bottom:20rpx; }
.done button { margin-top:40rpx; }