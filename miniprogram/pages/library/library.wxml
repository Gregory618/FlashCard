<view class="page"><view class="library-head"><view class="library-title">我的词库</view><view class="muted">{{cards.length}} 个单词与短语</view></view><view class="search"><input placeholder="搜索英文词汇或中文释义" value="{{keyword}}" bindinput="search"/></view><view wx:for="{{filtered}}" wx:key="id" class="card item"><view class="item-word">{{item.word}}</view><view class="item-sentence">{{item.sentence}}</view><view class="item-meaning">{{item.meaning}}</view><view class="item-meta muted">复习 {{item.reviewCount||0}} 次 · 下次：{{item.dueLabel}}</view></view><view wx:if="{{filtered.length===0}}" class="muted no-result">没有找到相关词汇。</view></view>