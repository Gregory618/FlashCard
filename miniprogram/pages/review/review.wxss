.topline{display:flex;justify-content:space-between;margin:12rpx 4rpx 24rpx}.flashcard{min-height:650rpx;display:flex;flex-direction:column;justify-content:center}.face-label{font-size:19rpx;letter-spacing:3rpx;color:#9AA3B2;text-align:center;margin-bottom:60rpx}.word{font-size:48rpx;font-weight:700;text-align:center;line-height:1.3;word-break:break-word}.example{font-size:30rpx;line-height:1.7;text-align:center;margin-top:42rpx;color:#47536A}.tap-hint{text-align:center;color:#A0A8B5;font-size:22rpx;margin-top:72rpx}.answer{padding:10rpx 0}.meaning{font-size:34rpx;font-weight:700;line-height:1.6}.detail-label{font-size:18rpx;letter-spacing:2rpx;color:#9AA3B2;margin-top:34rpx}.detail{font-size:26rpx;line-height:1.7;margin-top:10rpx;color:#47536A}.actions{display:flex;gap:20rpx;margin-top:26rpx}.actions button{flex:1}.miss-btn{background:#FFF0ED;color:#C64D35}.schedule-note{text-align:center;font-size:21rpx;margin-top:32rpx}.empty{margin-top:80rpx;text-align:center;padding:70rpx 34rpx}.empty-title{font-size:38rpx;font-weight:700;margin-bottom:20rpx}.empty button{margin-top:36rpx}