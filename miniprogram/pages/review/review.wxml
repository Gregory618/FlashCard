<view class="page review-page"><view class="topline"><text class="muted">今日复习</text><text class="muted">{{index+1}} / {{queue.length}}</text></view><view wx:if="{{current}}" class="flashcard card" bindtap="flip"><view class="face-label">{{flipped?'CARD BACK':'CARD FRONT'}}</view><view wx:if="{{!flipped}}"><view class="word">{{current.word}}</view><view class="example">{{current.sentence}}</view><view class="tap-hint">想好意思后，点击卡片翻面</view></view><view wx:else class="answer"><view class="meaning">{{current.meaning}}</view><view class="detail-label">SYNONYMS & RELATED WORDS</view><view class="detail">{{current.synonyms||'—'}}</view><view wx:if="{{current.notes}}" class="detail-label">USAGE NOTES</view><view wx:if="{{current.notes}}" class="detail">{{current.notes}}</view></view></view><view wx:if="{{current&&flipped}}" class="actions"><button class="miss-btn" bindtap="answer" data-known="false">没想起来</button><button class="primary" bindtap="answer" data-known="true">记起来了</button></view><view wx:if="{{!current}}" class="card empty"><view class="empty-title">今天的复习完成！</view><view class="muted">到期词汇已经全部复习。明天再来巩固记忆。</view><button class="secondary" bindtap="goHome">返回首页</button></view><view class="muted schedule-note">答对：进入下一复习间隔。答错：明天再次出现。</view></view>